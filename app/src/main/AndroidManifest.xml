<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 模型接口调用 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 悬浮窗兜底路径（首选 TYPE_ACCESSIBILITY_OVERLAY 免此权限, 个别 ROM 拒绝时才用） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 保活前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 包可见性(Android 11+): 控制台检测被适配的聊天 App 是否安装 -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 采集服务: 类全名伪装成系统 SelectToSpeakService（组件标识 = 本包名/该类全名,
             与系统 TalkBack 包下同名类不冲突）。这是读到微信 8.0.52+ 混淆节点的关键,
             绝不重命名。 -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:label="@string/svc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/config_disguised" />
        </service>

        <!-- 保活: 把进程抬到前台重要级, 防 MIUI/HyperOS 冻结无障碍服务 -->
        <service
            android:name=".capture.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep the accessibility chat reader alive on aggressive OEM power management" />
        </service>

    </application>
</manifest>
